      { "fromNode": "sr", "fromSlot": "scope", "toNode": "r_ee",  "toSlot": "scope" },
      { "fromNode": "sr", "fromSlot": "scope", "toNode": "r_eg",  "toSlot": "scope" },
      { "fromNode": "sr", "fromSlot": "scope", "toNode": "asm",   "toSlot": "scope" },

      { "fromNode": "qe", "fromSlot": "queryEmbedding", "toNode": "r_dv", "toSlot": "queryEmbedding" },

      { "fromNode": "qu", "fromSlot": "understanding", "toNode": "r_ee", "toSlot": "understanding" },
