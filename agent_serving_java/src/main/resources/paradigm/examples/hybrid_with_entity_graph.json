      { "fromNode": "qu", "fromSlot": "understanding", "toNode": "asm",  "toSlot": "understanding" },

      { "fromNode": "r_fts", "fromSlot": "candidates", "toNode": "fuse", "toSlot": "candidates" },
      { "fromNode": "r_dv",  "fromSlot": "candidates", "toNode": "fuse", "toSlot": "candidates" },
