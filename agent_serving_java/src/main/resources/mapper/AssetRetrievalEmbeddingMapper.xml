<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetRetrievalEmbeddingMapper">

    <resultMap id="embeddingRowMap"
               type="com.coremasterkb.serving.mapper.result.EmbeddingRow">
        <result column="retrieval_unit_id"    property="retrievalUnitId"/>
        <result column="embedding_vector"     property="embeddingVector"/>
        <result column="embedding_dim"        property="embeddingDim"/>
        <result column="cosine_score"         property="cosineScore"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="text"                 property="text"/>
        <result column="title"                property="title"/>
        <result column="block_type"           property="blockType"/>
        <result column="semantic_role"        property="semanticRole"/>
        <result column="source_refs_json"     property="sourceRefsJson"/>
        <result column="facets_json"          property="facetsJson"/>
        <result column="target_type"          property="targetType"/>
        <result column="target_ref_json"      property="targetRefJson"/>
        <result column="unit_type"            property="unitType"/>
        <result column="source_segment_id"    property="sourceSegmentId"/>
    </resultMap>

    <!--
        Load embeddings + unit metadata for active snapshots.
        text_kind filter omitted temporarily; one embedding per unit is assumed.
    -->
    <select id="selectWithUnitMeta" resultMap="embeddingRowMap">
        SELECT re.retrieval_unit_id,
               re.embedding_vector,
               re.embedding_dim,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id
        FROM asset_retrieval_embeddings re
        JOIN asset_retrieval_units ru ON re.retrieval_unit_id = ru.id
        WHERE ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        LIMIT #{limit}
    </select>


    <!--
        Top-K nearest-neighbour search using pgvector cosine distance.
        Ranking and scoring are fully server-side; no in-JVM vector math.
        Scope filter (JSONB @>) is pushed down when scopeJsonParams is non-empty.
        Retry without scope by passing an empty list.
    -->
    <select id="selectTopKByVector" resultMap="embeddingRowMap">
        SELECT re.retrieval_unit_id,
               (1 - (re.embedding_vector_vec &lt;=&gt; #{queryVector}::vector)) AS cosine_score,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id
        FROM asset_retrieval_embeddings re
        JOIN asset_retrieval_units ru ON re.retrieval_unit_id = ru.id
        WHERE ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        AND re.embedding_dim = #{dim}
        <foreach collection="scopeJsonParams" item="scopeParam">
            AND ru.facets_json @&gt; #{scopeParam}::jsonb
        </foreach>
        <if test="sectionPrefixes != null and sectionPrefixes.size() > 0">
        AND EXISTS (
            SELECT 1 FROM asset_raw_segments rs
            WHERE rs.id = ru.source_segment_id
              AND lower(btrim(rs.section_path::jsonb -&gt; 0 -&gt;&gt; 'title')) IN
            <foreach collection="sectionPrefixes" item="p" open="(" separator="," close=")">
                #{p}
            </foreach>
        )
        </if>
        ORDER BY re.embedding_vector_vec &lt;=&gt; #{queryVector}::vector
        LIMIT #{topK}
    </select>

</mapper>
