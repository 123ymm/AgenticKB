<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.operator.mapper.OperatorEmbeddingMapper">

    <resultMap id="embeddingRowMap"
               type="com.coremasterkb.serving.mapper.result.EmbeddingRow">
        <result column="retrieval_unit_id"    property="retrievalUnitId"/>
        <result column="embedding_dim"        property="embeddingDim"/>
        <result column="cosine_score"         property="cosineScore"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="text"                 property="text"/>
        <result column="title"                property="title"/>
        <result column="block_type"           property="blockType"/>
        <result column="semantic_role"        property="semanticRole"/>
        <result column="source_refs_json"     property="sourceRefsJson"/>
        <result column="facets_json"          property="facetsJson"/>
        <result column="target_type"          property="targetType"/>
        <result column="target_ref_json"      property="targetRefJson"/>
        <result column="unit_type"            property="unitType"/>
        <result column="source_segment_id"    property="sourceSegmentId"/>
    </resultMap>

    <!--
        Top-K pgvector cosine search filtered by text_kind ("检索范围").
        DISTINCT ON (retrieval_unit_id) keeps the closest embedding per unit when a unit has
        several text_kind embeddings; the outer query then orders by cosine score and limits.
        Unlike retrieval-time SQL elsewhere, text / source_refs_json / target_ref_json are
        selected directly (no deferred hydration) so reranking and assembly downstream see full text.
        Uses embedding_vector_vec (the real pgvector column), not the legacy embedding_vector TEXT column.
    -->
    <select id="selectTopKByVectorAndTextKind" resultMap="embeddingRowMap">
        SELECT t.* FROM (
            SELECT DISTINCT ON (re.retrieval_unit_id)
                   re.retrieval_unit_id,
                   re.embedding_dim,
                   (1 - (re.embedding_vector_vec &lt;=&gt; #{queryVector}::vector)) AS cosine_score,
                   ru.document_snapshot_id,
                   ru.text,
                   ru.title,
                   ru.block_type,
                   ru.semantic_role,
                   ru.source_refs_json,
                   ru.facets_json,
                   ru.target_type,
                   ru.target_ref_json,
                   ru.unit_type,
                   ru.source_segment_id
            FROM asset_retrieval_embeddings re
            JOIN asset_retrieval_units ru ON re.retrieval_unit_id = ru.id
            WHERE ru.document_snapshot_id IN
            <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
                #{sid}
            </foreach>
              AND re.embedding_dim = #{dim}
            <if test="textKinds != null and textKinds.size() > 0">
              <!-- "检索范围" filters on the retrieval unit's unit_type (raw_text / generated_question).
                   The embedding's own text_kind is uniformly 'full' in the asset data, so the
                   raw_text vs question distinction lives on asset_retrieval_units.unit_type. -->
              AND ru.unit_type IN
              <foreach collection="textKinds" item="tk" open="(" separator="," close=")">
                  #{tk}
              </foreach>
            </if>
            <foreach collection="scopeJsonParams" item="scopeParam">
              AND ru.facets_json @&gt; #{scopeParam}::jsonb
            </foreach>
            ORDER BY re.retrieval_unit_id, re.embedding_vector_vec &lt;=&gt; #{queryVector}::vector
        ) t
        ORDER BY t.cosine_score DESC
        LIMIT #{topK}
    </select>

</mapper>
