<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetPublishReleaseMapper">

    <select id="selectActiveByDomain" resultType="com.coremasterkb.serving.entity.AssetPublishRelease">
        SELECT id, status, domain, channel, build_id AS buildId
        FROM asset_publish_releases
        WHERE status = 'active' AND domain = #{domain}
    </select>

</mapper>
