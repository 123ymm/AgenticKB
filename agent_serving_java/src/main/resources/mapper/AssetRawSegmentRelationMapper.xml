<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetRawSegmentRelationMapper">

    <resultMap id="relationResult"
               type="com.coremasterkb.serving.mapper.result.RelationRow">
        <result column="id"               property="id"/>
        <result column="from_segment_id"  property="fromSegmentId"/>
        <result column="to_segment_id"    property="toSegmentId"/>
        <result column="relation_type"    property="relationType"/>
        <result column="distance"         property="distance"/>
    </resultMap>

    <resultMap id="neighborResult"
               type="com.coremasterkb.serving.mapper.result.NeighborRow">
        <result column="from_id"       property="fromId"/>
        <result column="neighbor_id"   property="neighborId"/>
        <result column="relation_type" property="relationType"/>
    </resultMap>

    <select id="selectRelationsForSegments" resultMap="relationResult">
        SELECT rel.id,
               rel.source_segment_id AS from_segment_id,
               rel.target_segment_id AS to_segment_id,
               rel.relation_type,
               rel.distance
        FROM asset_raw_segment_relations rel
        WHERE (
            rel.source_segment_id IN
            <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR rel.target_segment_id IN
            <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        )
        <if test="relationTypes != null and relationTypes.size() > 0">
        AND rel.relation_type IN
        <foreach collection="relationTypes" item="rt" open="(" separator="," close=")">
            #{rt}
        </foreach>
        </if>
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        AND rel.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        </if>
    </select>

    <!--
        BFS one-hop neighbor query using UNION ALL for bidirectional edges.
        When snapshotIds is provided, JOIN on raw_segments to enforce snapshot scope.
    -->
    <select id="selectNeighbors" resultMap="neighborResult">
        SELECT rel.source_segment_id AS from_id,
               rel.target_segment_id AS neighbor_id,
               rel.relation_type
        FROM asset_raw_segment_relations rel
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        JOIN asset_raw_segments rs_src ON rel.source_segment_id = rs_src.id
        JOIN asset_raw_segments rs_tgt ON rel.target_segment_id = rs_tgt.id
        </if>
        WHERE rel.source_segment_id IN
        <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="relationTypes != null and relationTypes.size() > 0">
        AND rel.relation_type IN
        <foreach collection="relationTypes" item="rt" open="(" separator="," close=")">
            #{rt}
        </foreach>
        </if>
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        AND rs_src.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        AND rs_tgt.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        </if>
        UNION ALL
        SELECT rel.target_segment_id AS from_id,
               rel.source_segment_id AS neighbor_id,
               rel.relation_type
        FROM asset_raw_segment_relations rel
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        JOIN asset_raw_segments rs_src ON rel.source_segment_id = rs_src.id
        JOIN asset_raw_segments rs_tgt ON rel.target_segment_id = rs_tgt.id
        </if>
        WHERE rel.target_segment_id IN
        <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="relationTypes != null and relationTypes.size() > 0">
        AND rel.relation_type IN
        <foreach collection="relationTypes" item="rt" open="(" separator="," close=")">
            #{rt}
        </foreach>
        </if>
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        AND rs_src.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        AND rs_tgt.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        </if>
    </select>

</mapper>
